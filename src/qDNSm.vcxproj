      <Branchless>Branchless2</Branchless>
      <!-- Size trims, Release only.

           GOTCHA, learned the hard way: MSBuild passes BOTH ClCompile/AdditionalOptions and
           Link/AdditionalOptions through verbatim. It does NOT split them on semicolons, so a
           trailing ';' becomes part of the last option: "-Os;%(AdditionalOptions)" reaches
           ps3ppusnc as "-Os;" and fails with "Command line error : Unrecognized option '-Os;'".
           That is also why an earlier round of flags looked "rejected" when they were merely
           carrying a semicolon. Separate options with spaces, never semicolons.

           The toolchain is ppu-lv2-gcc-4.1.1, which predates LTO (GCC 4.5), so cross-module
           dead stripping happens at link time instead - see the Link section below.

           -Os overrides the -O2 from OptimizationLevel=Level2, because GCC honours the last
           -O flag. -fno-exceptions and -fno-rtti are safe: there is no throw, catch,
           dynamic_cast or typeid anywhere in the sources. Neither is -O-prefixed, so if this
           toolchain does not support one it degrades to a warning rather than breaking the
           build the way a malformed -Os does. They are kept in the hope they apply; if the
           build prints "Unrecognized option" for either, drop it.

           -fdata-sections is deliberately absent: cc1plus carries that name only as the error
           text "not supported for this target", so there is no data-section splitting here and
           dead stripping can only discard unreferenced functions. -->
      <AdditionalOptions>-Os %(AdditionalOptions)</AdditionalOptions>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
    </ClCompile>
    <Link>
      <AdditionalDependencies>
        <!-- ecrti.o provides __fini and is a bare .o outside any .a. Do NOT add crt1.o: it carries a .sys_proc_prx_param section that ps3ppuld cannot place under -oformat=prx, which breaks prx-fixup. _exit and __exit_user_prx_modules come from Core/CrtStubs.c instead. -->$(SCE_PS3_ROOT)\host-win32\ppu\lib\gcc\ppu-lv2\4.1.1\ecrti.o;-lsysutil_np_stub;-lnet_stub;-lnetctl_stub;$(SCE_PS3_ROOT)\target\ppu\lib\libc.a;$(SN_PS3_PATH)\ppu\lib\sn\libsn.a;$(SCE_PS3_ROOT)\target\ppu\lib\libm.a;$(SCE_PS3_ROOT)\target\ppu\lib\libio_stub.a;$(SCE_PS3_ROOT)\target\ppu\lib\liblv2_stub.a;$(SCE_PS3_ROOT)\target\ppu\lib\libc_stub.a;$(SCE_PS3_ROOT)\target\ppu\lib\libsysutil_stub.a;$(SCE_PS3_ROOT)\target\ppu\lib\libsyscall.a;$(SCE_PS3_ROOT)\target\ppu\lib\hash\libsha256.a;-lvshtask_export_stub;-lpaf_export_stub;-lvshmain_export_stub;-lvshcommon_export_stub;-lstdc_export_stub;-lallocator_export_stub;-lsys_net_export_stub;-lxsetting_export_stub;-lnetctl_main_export_stub;-lsysPrxForUser_export_stub;%(AdditionalDependencies)</AdditionalDependencies>
      <!-- Dead-code stripping. ps3ppuld accepts gc-sections but warns L0153 that it is
           deprecated in favour of strip-unused-data, so use the current name directly and
           save the warning.
           NOTE: MSBuild splits ClCompile/AdditionalOptions on semicolons but passes
           Link/AdditionalOptions through verbatim, so a semicolon here reaches ld as part of
           the option and the linker rejects it. Separate with a space.
           Verified working: FindPattern, GetCurrentToc, GetTemperature and WriteProcessMemory
           are absent from the linked PRX. It strips nothing further today because everything
           else is reachable from the module entry points and the Detour calls in Hooks.cpp.
           The PRX metadata the loader needs (.lib.ent.top, .lib.stub.top, .psp_lib_mark_,
           .rodata.sceModuleInfo) is KEEP'd by the linker script; if a module ever loads but
           misbehaves, this flag is the first suspect. -->
      <AdditionalOptions>--strip-unused-data %(AdditionalOptions)</AdditionalOptions>
    </Link>
